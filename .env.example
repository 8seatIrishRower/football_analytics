# Copy this file to .env and fill in your own values.
# See README.md for step-by-step instructions.

# Pooled connection string from Neon (used for normal app queries).
# In the Neon console this is the one with "-pooler" in the hostname.
DATABASE_URL="postgresql://user:password@ep-example-pooler.aws.neon.tech/dbname?sslmode=require"

# Direct (non-pooled) connection string — same database, used only when
# applying migrations. In Neon, toggle "Pooled connection" off to get this
# one; the hostname is the same but without "-pooler".
DIRECT_URL="postgresql://user:password@ep-example.aws.neon.tech/dbname?sslmode=require"

# The shared password coaches use to log in.
COACH_PASSWORD="changeme"

# Random secret used to sign the login cookie. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=""
