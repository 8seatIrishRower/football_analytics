// Prisma schema for the youth football tracker.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  // The classic generator with its default output location
  // (node_modules/.prisma/client) — Vercel's build system has built-in,
  // well-tested support for finding and bundling engine files there.
  // The newer "prisma-client" generator with a custom output path (what
  // this used to be) isn't reliably picked up by Vercel's tooling yet.
  provider      = "prisma-client-js"
  // "native" covers local dev machines; "rhel-openssl-3.0.x" is what
  // Vercel's serverless functions actually run on at request time (it
  // differs from Vercel's build container, which is why this can't be
  // auto-detected — see https://pris.ly/d/engines).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (used above for normal app queries) isn't
  // reliable for running migrations. DIRECT_URL is the same database's
  // non-pooled connection string, used only when applying migrations.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Phase 1: players (on a Team) + physical testing results.
// Phase 2: Team/Game/Play/PlayParticipant for play-by-play charting of any
// tracked team (your own youth team, or any other team's games/roster).
// ---------------------------------------------------------------------------

enum TeamLevel {
  YOUTH
  HIGH_SCHOOL
  COLLEGE
  NFL
}

model Team {
  id        String    @id @default(cuid())
  name      String    @unique
  level     TeamLevel
  createdAt DateTime  @default(now())

  players Player[]
  games   Game[]

  @@map("teams")
}

model Player {
  id           String    @id @default(cuid())
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  name         String
  jerseyNumber Int?
  positions    String[]  @default([])

  // The fields below are only meaningful for a coach's own Youth-level
  // roster; they stay null for other teams' players (e.g. Notre Dame's
  // roster, kept only for stat-attribution, has no guardian/medical info).
  dateOfBirth  DateTime? @db.Date
  heightInches Float?
  weightLbs    Float?

  // Two guardian slots as plain fields rather than a related table — covers
  // the common case (up to two parents/guardians) without extra add/remove
  // list UI. Ask if a third is ever needed; it's a one-line schema change.
  guardian1Name  String?
  guardian1Phone String?
  guardian1Email String?
  guardian2Name  String?
  guardian2Phone String?
  guardian2Email String?

  // Free-form: emergency contact (if different from the guardians above)
  // and/or medical notes (allergies, conditions), whichever applies.
  emergencyMedicalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testResults      TestResult[]
  playParticipants PlayParticipant[]

  @@index([teamId])
  @@map("players")
}

model Game {
  id            String   @id @default(cuid())
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  opponentName  String
  playedOn      DateTime @db.Date
  teamScore     Int?
  opponentScore Int?
  createdAt     DateTime @default(now())

  plays Play[]

  @@index([teamId])
  @@map("games")
}

enum GameSide {
  OFFENSE
  DEFENSE
  SPECIAL_TEAMS
}

enum PlayType {
  RUN
  PASS
  PUNT
  KICKOFF
  FIELD_GOAL
  EXTRA_POINT
  TWO_POINT
  PENALTY
  KNEEL
  SPIKE
  OTHER
}

// Attributes a player to a play with a specific role — this is what lets
// individual stats (rushing, tackles, sacks, ...) be tallied per player.
enum ParticipantRole {
  BALL_CARRIER
  PASSER
  RECEIVER
  TACKLE
  ASSIST_TACKLE
  SACK
  FORCED_FUMBLE
  FUMBLE_RECOVERY
  INTERCEPTION
}

model Play {
  id       String   @id @default(cuid())
  gameId   String
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // Sequence within the game, since plays have no other natural ordering.
  playNumber Int
  quarter    Int
  down       Int?
  distance   Int?
  // Whether the tracked team (Game.team) was on offense, defense, or a
  // special teams unit for this play.
  side       GameSide
  formation  String?
  playType   PlayType
  yardsGained Int?
  fumble      Boolean  @default(false)
  // Only set on scoring plays — running score situation is derived from
  // these rather than re-entered on every non-scoring play.
  teamScoreAfter     Int?
  opponentScoreAfter Int?
  notes       String?
  createdAt   DateTime @default(now())

  participants PlayParticipant[]

  @@index([gameId])
  @@map("plays")
}

model PlayParticipant {
  id       String          @id @default(cuid())
  playId   String
  play     Play            @relation(fields: [playId], references: [id], onDelete: Cascade)
  playerId String
  player   Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  role     ParticipantRole

  @@index([playId])
  @@index([playerId])
  @@map("play_participants")
}

enum TestValueType {
  TIME
  DISTANCE
}

enum PadLevel {
  FULL_PADS_HELMET
  FULL_PADS_NO_HELMET
  NO_PADS_NO_HELMET
}

// A catalog of physical tests, so new ones (vertical jump, pro-agility,
// bench reps, ...) can be added later without a schema change or deploy.
model TestType {
  id        String        @id @default(cuid())
  name      String        @unique
  unit      String
  valueType TestValueType @default(TIME)
  // Whether a lower result is the better result (e.g. sprint time in
  // seconds) vs. a higher result being better (e.g. broad jump distance).
  // Used to compute "best result" and rankings.
  lowerIsBetter Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  testResults TestResult[]

  @@map("test_types")
}

model TestResult {
  id         String    @id @default(cuid())
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  testTypeId String
  testType   TestType  @relation(fields: [testTypeId], references: [id], onDelete: Restrict)
  // Canonical storage unit regardless of display format: seconds for TIME
  // tests, total inches for DISTANCE tests (see src/lib/format.ts).
  value      Float
  padLevel   PadLevel?
  recordedOn DateTime  @db.Date
  createdAt  DateTime  @default(now())

  @@index([playerId])
  @@index([testTypeId])
  @@map("testing_results")
}
